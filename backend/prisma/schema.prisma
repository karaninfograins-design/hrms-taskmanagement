generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}

enum SprintType {
  WEEKLY
  MONTHLY
  MANUAL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  FEATURE
  BUG
  SUBTASK
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)
  status      Boolean @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Designation {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  status      Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(20)
  description String?   @db.VarChar(255)
  status      Boolean   @default(true)

  employeeProfiles EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(150)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  phoneNumber  String?    @db.VarChar(30)
  status       UserStatus @default(ACTIVE)

  roleId        Int
  designationId Int?

  role        Role         @relation(fields: [roleId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  employeeProfile EmployeeProfile?

  assignedWorkItems WorkItem[] @relation("Assignee")
  assignedWorkItemLinks WorkItemAssignee[]
  reportedWorkItems WorkItem[] @relation("Reporter")
  createdWorkItems  WorkItem[] @relation("WorkItemCreator")

  comments           Comment[]
  workItemActivities WorkItemActivity[]

  createdProjects Project[]       @relation("ProjectCreator")
  projectMembers  ProjectMember[]

  createdSprints Sprint[] @relation("SprintCreator")

  attendances          Attendance[]
  leaveBalances        LeaveBalance[]
  requestedLeaves      LeaveRequest[]        @relation("LeaveRequester")
  approvedLeaves       LeaveRequest[]        @relation("LeaveApprover")
  organizedMeetings    Meeting[]             @relation("MeetingOrganizer")
  meetingParticipants  MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([designationId])
}

model EmployeeProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  employeeCode       String    @unique @db.VarChar(50)
  dob                DateTime?
  gender             String?   @db.VarChar(20)
  address            String?   @db.Text
  dateOfJoining      DateTime?
  employmentType     String?   @default("FULL_TIME") @db.VarChar(50)
  employmentStatus   String?   @default("PERMANENT") @db.VarChar(50)
  workLocation       String?   @default("OFFICE") @db.VarChar(100)
  departmentId       Int?
  reportingManagerId Int?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([reportingManagerId])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  userId       Int
  date         DateTime         @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  workingHours Float            @default(0)
  remarks      String?          @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model LeaveType {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  daysAllowed Int       @default(12)
  description String?   @db.VarChar(255)
  status      Boolean   @default(true)

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveBalance {
  id          Int      @id @default(autoincrement())
  userId      Int
  leaveTypeId Int
  allocated   Int      @default(12)
  used        Int      @default(0)
  remaining   Int      @default(12)
  year        Int      @default(2026)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([leaveTypeId])
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  userId          Int
  leaveTypeId     Int
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Int
  reason          String      @db.Text
  status          LeaveStatus @default(PENDING)
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?     @db.VarChar(255)

  user       User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([leaveTypeId])
  @@index([approvedById])
}

model Meeting {
  id             Int           @id @default(autoincrement())
  title          String        @db.VarChar(200)
  description    String?       @db.Text
  roomName       String        @unique @db.VarChar(100)
  organizerId    Int
  projectId      Int?
  startTime      DateTime
  endTime        DateTime
  locationOrLink String?       @db.VarChar(255)
  status         MeetingStatus @default(SCHEDULED)

  organizer User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members   MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([projectId])
}

model MeetingParticipant {
  meetingId Int
  userId    Int
  status    ParticipantStatus @default(INVITED)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model HRSetting {
  id       Int     @id @default(autoincrement())
  category String  @db.VarChar(50)
  key      String  @db.VarChar(100)
  value    String  @db.VarChar(255)
  isSystem Boolean @default(false)
  status   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, key])
  @@index([category])
}

model Project {
  id          Int           @id @default(autoincrement())
  key         String?       @db.VarChar(10)
  name        String        @db.VarChar(150)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  startDate DateTime?
  endDate   DateTime?

  createdById Int

  createdBy User @relation("ProjectCreator", fields: [createdById], references: [id])

  members   ProjectMember[]
  sprints   Sprint[]
  workItems WorkItem[]
  meetings  Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([projectId, userId])
}

model Sprint {
  id          Int          @id @default(autoincrement())
  projectId   Int
  name        String       @db.VarChar(150)
  description String?      @db.Text
  type        SprintType
  status      SprintStatus @default(PLANNED)

  startDate DateTime
  endDate   DateTime

  createdById Int

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SprintCreator", fields: [createdById], references: [id])

  workItems WorkItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdById])
}

model WorkItem {
  id          Int            @id @default(autoincrement())
  keyNumber   Int?
  projectId   Int
  sprintId    Int?
  type        WorkItemType
  title       String         @db.VarChar(255)
  description String?        @db.Text
  status      WorkItemStatus @default(TODO)
  priority    Priority       @default(MEDIUM)

  assigneeId  Int?
  reporterId  Int?
  parentId    Int?
  createdById Int

  startDate DateTime?
  dueDate   DateTime?
  storyPoints String? @db.VarChar(50)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint  Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assignee User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  parent   WorkItem?  @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children WorkItem[] @relation("WorkItemHierarchy")

  createdBy User @relation("WorkItemCreator", fields: [createdById], references: [id])

  comments   Comment[]
  activities WorkItemActivity[]
  assignees  WorkItemAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentId])
  @@index([type])
  @@index([status])
}

model WorkItemAssignee {
  workItemId Int
  userId     Int

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
  @@index([workItemId])
  @@index([userId])
}


model WorkItemActivity {
  id          Int      @id @default(autoincrement())
  workItemId  Int
  userId      Int
  action      String   @db.VarChar(100)
  field       String?  @db.VarChar(50)
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  createdAt   DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workItemId])
  @@index([userId])
}

model Comment {
  id         Int    @id @default(autoincrement())
  workItemId Int
  userId     Int
  content    String @db.Text

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workItemId])
  @@index([userId])
}
