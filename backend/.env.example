# ===================================================
# HRMS Backend Environment Configuration (.env)
# ===================================================

# Server Port
PORT=5000

# Database Connection Settings (Prisma / MariaDB / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hrms_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=hrms_db
# Enable only for trusted local MySQL connections that require caching_sha2_password key retrieval.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Full Database URL (Prisma connection string format)
DATABASE_URL="mysql://hrms_user:YourStrongDatabasePassword123!@localhost:3306/hrms_db"

# JWT Secret Key for Bearer Authentication
JWT_SECRET="production_super_secret_jwt_key_please_change_this_in_prod"

# Node Environment
NODE_ENV=production

# Public backend URL used to generate absolute attachment links.
PUBLIC_API_URL=http://localhost:5000
E2E_BASE_URL=http://localhost:5000

# LiveKit server configuration. Keep credentials in the backend environment only.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-a-secure-livekit-secret

# Required for the initial production seed; use a unique, strong password.
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
