# ===================================================
# HRMS Frontend Environment Configuration (.env.local)
# ===================================================

# Public API Base URL for backend communication (accessible from browser & LAN)
NEXT_PUBLIC_API_URL=http://localhost:5000

# NextAuth Secret
NEXTAUTH_SECRET="production_nextauth_secret_please_change"
NEXTAUTH_URL=http://localhost:3000

# Node Environment
NODE_ENV=production
