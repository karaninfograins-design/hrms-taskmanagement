# Public URLs are embedded in the client bundle; set these to reachable URLs for each environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Keep aligned with NEXT_PUBLIC_APP_URL when the application uses NextAuth.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-secret
